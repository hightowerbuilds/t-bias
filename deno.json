{
  "desktop": {
    "app": {
      "name": "t-bias",
      "identifier": "com.tbias.app"
    },
    "backend": "webview",
    "output": {
      "macos": "./dist-app/t-bias.app"
    }
  },
  "tasks": {
    "serve": "deno run -A --watch main.ts",
    "desktop": "deno desktop main.ts",
    "desktop:hmr": "deno desktop --hmr main.ts",
    "desktop:build": "bun run build && deno task desktop && deno run -A scripts/package-sidecar.ts"
  },
  "fmt": {
    "exclude": ["dist/", "dist-app/", "node_modules/"]
  },
  "lint": {
    "exclude": ["dist/", "dist-app/", "node_modules/", "src/"]
  }
}
